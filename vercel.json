{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "prototypes/mobile.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/mobile/?",
      "dest": "/index.html"
    },
    {
      "src": "/mobile-preview/?",
      "dest": "/prototypes/mobile.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://careers-technology-mon-vid.trycloudflare.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://careers-technology-mon-vid.trycloudflare.com/uploads/$1"
    },
    {
      "src": "/clips/(.*)",
      "dest": "https://careers-technology-mon-vid.trycloudflare.com/clips/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
