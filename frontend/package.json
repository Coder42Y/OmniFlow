{
  "name": "omniflow-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/sync-tokens.js",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node tools/sync-tokens.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js",
    "format:check": "prettier --check src tests e2e tools vite.config.js package.json index.html"
  },
  "dependencies": {
    "marked": "^18.0.12",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "28.1.0",
    "playwright": "1.58.2",
    "prettier": "3.9.6",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
